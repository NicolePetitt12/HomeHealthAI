# Local Supabase (npx supabase start)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

PORT=3000

# OpenAI Edge Function secret — set via:
#   npx supabase secrets set OPENAI_API_KEY=sk-...
# (Do NOT put the real key here — this file may be committed)
OPENAI_API_KEY=sk-...

# Stripe Edge Function secrets — set via:
#   npx supabase secrets set STRIPE_SECRET_KEY=sk_test_...
#   npx supabase secrets set STRIPE_WEBHOOK_SECRET=whsec_...
#   npx supabase secrets set WEBHOOK_BASE_URL=https://your-domain.com
# (Do NOT put real values here — this file may be committed)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Public domain where Supabase Edge Functions are reachable (used by stripe-setup
# to register the correct webhook URL with Stripe). Defaults to SUPABASE_URL if not set.
WEBHOOK_BASE_URL=https://your-domain.com

# Google OAuth (get from Google Cloud Console → Credentials → OAuth 2.0 Client ID → Web application)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your-google-client-secret
