# Local Supabase (npx supabase start inside apps/backend/)
# Use your machine's LAN IP (not 127.0.0.1) — devices/emulators can't reach localhost
# Run: ip route get 1.1.1.1 | awk '{print $7; exit}'
EXPO_PUBLIC_SUPABASE_URL=http://<your-lan-ip>:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Backend API
EXPO_PUBLIC_API_URL=http://<your-lan-ip>:3000/api
